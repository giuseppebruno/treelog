# Directory containing the nginx or Apache logs on the host (Apache: /var/log/apache2). Mounted read-only.
LOG_DIR=/var/log/nginx
# Numeric group id that owns the log files: stat -c %g /var/log/nginx/access.log
LOG_GID=4
# Timezone of the host writing the logs. Needed because error log timestamps carry no UTC offset.
TZ=Europe/Rome

# =============================================================================
# Dashboard
# =============================================================================

PORT=8080
# HTTP basic authentication; set both to enable it (recommended behind a reverse proxy).
# DASH_USER=
# DASH_PASS=

# =============================================================================
# Log sources and retention
# =============================================================================

# Comma-separated glob patterns for access and error logs ("**" matches subdirectories).
# ACCESS_LOGS=/logs/**/*access*.log*
# ERROR_LOGS=/logs/**/*error*.log*
# Custom access log format: regular expression with the named groups ip, ts, req, status and ua (optional: vhost).
# ACCESS_REGEX=
# History length in hours.
# RETENTION_HOURS=48
# On first start, read at most the last N megabytes of each log file.
# BACKFILL_MB=200

# =============================================================================
# Virtual hosts
# =============================================================================

# Regular expression applied to the log file path, with a named group "vhost".
# VHOST_REGEX=

# =============================================================================
# Exclusions
# =============================================================================

# Source addresses to ignore, comma-separated (for example uptime monitors).
# IGNORE_IPS=
# Regular expression matched against the request line; matching requests are ignored.
# IGNORE_REGEX=

# =============================================================================
# IP geolocation (country and ASN)
# =============================================================================

# Disabled unless IPINFO_TOKEN is set. Providers:
#   api:  per-address lookups against the IPinfo Lite API (source IP addresses are sent to IPinfo). Default.
#   mmdb: Treelog downloads the IPinfo Lite database and keeps it refreshed; lookups stay local.
# IPINFO_TOKEN=
# GEO_PROVIDER=auto

# =============================================================================
# Alerting
# =============================================================================

# Prefix for notification titles and a link back to the dashboard.
# ALERT_NAME=production
# ALERT_DASHBOARD_URL=
# ntfy: topic URL and optional access token.
# ALERT_NTFY_URL=
# ALERT_NTFY_TOKEN=
# Telegram: bot token and destination chat id.
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Generic webhook; requests are signed with HMAC-SHA256 when a secret is set.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_SECRET=

# Enabled rules: server_errors, exposed, error_rate, spike, silence, offenders.
# ALERT_RULES=server_errors,exposed,error_rate,spike
# Minimum time between repeated notifications for the same rule.
# ALERT_COOLDOWN_MINUTES=60
# server_errors: hostile requests that received 5xx.
# ALERT_ATTACK_5XX_MIN=5
# exposed: high-risk requests (RCE, SQL injection, traversal) served 2xx.
# ALERT_EXPOSED_MIN=3
# error_rate: ratio of 5xx responses.
# ALERT_5XX_RATE=0.05
# spike: minimum hostile requests, and multiple of the previous 24 hour average.
# ALERT_SPIKE_MIN=200
# ALERT_SPIKE_FACTOR=4
# silence: minutes without new access log lines (0 disables the rule).
# ALERT_SILENCE_MINUTES=0

# =============================================================================
# Offending IP detection
# =============================================================================

# Thresholds over a 10 minute window: distinct paths answered with 4xx, login attempts, total requests, hostile requests.
# SCAN_MIN=30
# BRUTE_MIN=15
# FLOOD_MIN=600
# ATTACK_MIN=20
